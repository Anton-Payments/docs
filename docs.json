{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Anton Payments",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "background": {
    "decoration": "windows"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "light": "github-light",
      "dark": "github-dark"
    }
  },
  "api": {
    "openapi": ["/openapi-merchant.yaml"],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["bash", "javascript", "python", "go"]
    }
  },
  "integrations": {
    "intercom": {
      "appId": "cofsfa9j"
    }
  },
  "search": {
    "prompt": "Search docs..."
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication",
              "environments"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/payouts",
              "concepts/payees",
              "concepts/balances",
              "concepts/webhooks",
              "concepts/pagination",
              "concepts/errors",
              "concepts/idempotency"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/send-a-payout",
              "guides/manage-payees",
              "guides/handle-webhooks",
              "guides/batch-payouts",
              "guides/error-handling",
              "guides/going-live"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Reference Data",
            "pages": [
              "api-reference/reference-data/list-currencies",
              "api-reference/reference-data/list-countries",
              "api-reference/reference-data/list-payment-methods"
            ]
          },
          {
            "group": "Payouts",
            "pages": [
              "api-reference/payouts/create-payout",
              "api-reference/payouts/list-payouts",
              "api-reference/payouts/get-payout",
              "api-reference/payouts/list-payout-events",
              "api-reference/payouts/cancel-payout"
            ]
          },
          {
            "group": "Payees",
            "pages": [
              "api-reference/payees/create-payee",
              "api-reference/payees/list-payees",
              "api-reference/payees/get-payee",
              "api-reference/payees/update-payee",
              "api-reference/payees/update-payee-pii",
              "api-reference/payees/delete-payee"
            ]
          },
          {
            "group": "Instruments",
            "pages": [
              "api-reference/instruments/create-instrument-for-payee",
              "api-reference/instruments/list-instruments-by-payee",
              "api-reference/instruments/list-instruments",
              "api-reference/instruments/get-instrument",
              "api-reference/instruments/update-instrument",
              "api-reference/instruments/delete-instrument"
            ]
          },
          {
            "group": "Balances",
            "pages": [
              "api-reference/balances/list-balances",
              "api-reference/balances/get-balance"
            ]
          },
          {
            "group": "Accounts",
            "pages": [
              "api-reference/accounts/list-accounts",
              "api-reference/accounts/get-account",
              "api-reference/accounts/get-account-details",
              "api-reference/accounts/list-account-transactions",
              "api-reference/accounts/list-transactions"
            ]
          },
          {
            "group": "Batches",
            "pages": [
              "api-reference/batches/download-batch-template",
              "api-reference/batches/upload-batch",
              "api-reference/batches/list-batches",
              "api-reference/batches/get-batch",
              "api-reference/batches/confirm-batch",
              "api-reference/batches/cancel-batch",
              "api-reference/batches/list-batch-payouts",
              "api-reference/batches/get-batch-errors",
              "api-reference/batches/get-batch-results"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks/create-webhook-subscription",
              "api-reference/webhooks/list-webhook-subscriptions",
              "api-reference/webhooks/get-webhook-subscription",
              "api-reference/webhooks/get-webhook-secret",
              "api-reference/webhooks/rotate-webhook-secret",
              "api-reference/webhooks/test-webhook-subscription",
              "api-reference/webhooks/deactivate-webhook-subscription",
              "api-reference/webhooks/delete-webhook-subscription",
              "api-reference/webhooks/list-webhook-events",
              "api-reference/webhooks/get-webhook-event",
              "api-reference/webhooks/list-webhook-event-deliveries"
            ]
          },
          {
            "group": "Documents",
            "pages": [
              "api-reference/documents/upload-document",
              "api-reference/documents/list-documents"
            ]
          },
          {
            "group": "RFIs",
            "pages": [
              "api-reference/rfis/list-rfis",
              "api-reference/rfis/get-rfi",
              "api-reference/rfis/respond-to-rfi"
            ]
          },
          {
            "group": "Pricing",
            "pages": [
              "api-reference/pricing/list-merchant-pricing",
              "api-reference/pricing/create-pricing-quote"
            ]
          },
          {
            "group": "FX",
            "pages": [
              "api-reference/fx/create-fx-quote",
              "api-reference/fx/get-indicative-fx-rate",
              "api-reference/fx/execute-fx-exchange",
              "api-reference/fx/list-fx-exchanges"
            ]
          },
          {
            "group": "Corridors",
            "pages": [
              "api-reference/corridors/list-corridors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Status",
          "href": "https://status.antonpayments.com",
          "icon": "signal"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@antonpayments.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.antonpayments.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Keys",
      "href": "https://app.antonpayments.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/anton-payments",
      "linkedin": "https://linkedin.com/company/antonpayments",
      "x": "https://x.com/antonpayments"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "indexing": "navigable"
  }
}
