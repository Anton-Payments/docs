{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Anton Payments",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/introduction"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "background": {
    "decoration": "windows"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "light": "github-light",
      "dark": "github-dark"
    }
  },
  "api": {
    "openapi": ["/openapi-merchant.yaml"],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["bash", "javascript", "php", "go"]
    }
  },
  "search": {
    "prompt": "Search docs..."
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication",
              "environments",
              "how-anton-evaluates-payouts"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/send-a-payout",
              "guides/crypto-payouts",
              "guides/manage-beneficiaries",
              "guides/handle-webhooks",
              "guides/batch-payouts",
              "guides/fx-exchange",
              "guides/going-live"
            ]
          },
          {
            "group": "Sandbox",
            "pages": [
              "sandbox/overview",
              "sandbox/test-data"
            ]
          },
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Cross-Cutting",
            "pages": [
              "api-reference/idempotency",
              "api-reference/pagination",
              "api-reference/rate-limits",
              "api-reference/errors",
              "api-reference/webhook-events",
              "api-reference/webhook-signing",
              "api-reference/ip-allowlist"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Status",
          "href": "https://status.antonpayments.com",
          "icon": "signal"
        },
        {
          "anchor": "Support",
          "href": "https://help.antonpayments.com",
          "icon": "life-ring"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.antonpayments.com"
      },
      {
        "label": "Dashboard",
        "href": "https://app.antonpayments.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Keys",
      "href": "https://app.antonpayments.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/anton-payments",
      "linkedin": "https://linkedin.com/company/antonpayments"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "indexing": "navigable"
  }
}
