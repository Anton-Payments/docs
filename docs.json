{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Anton Payments",
  "colors": {
    "primary": "#2563EB",
    "light": "#3B82F6",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/introduction"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "background": {
    "decoration": "windows"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "light": "github-light",
      "dark": "github-dark"
    }
  },
  "api": {
    "openapi": [
      "/openapi-merchant.yaml"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "php",
        "go"
      ]
    }
  },
  "search": {
    "prompt": "Search docs..."
  },
