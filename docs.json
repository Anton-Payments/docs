    {
      "source": "/api-reference/instruments/list-instruments-for-beneficiary",
      "destination": "/api-reference/instruments/list-instruments"
    },
    {
      "source": "/api-reference/intelligence/get-evidence",
      "destination": "/api-reference/intelligence/get-evaluation"
    },
    {
      "source": "/api-reference/webhooks/get-webhook-secret",
