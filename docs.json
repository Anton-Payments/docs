  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.antonpayments.com"
      },
      {
        "label": "Dashboard",
        "href": "https://app.antonpayments.com"
      },
      {
        "label": "Download OpenAPI",
        "href": "/openapi-merchant.yaml"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get credentials",
      "href": "https://app.antonpayments.com"
    }
