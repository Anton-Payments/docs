    "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"]
  },
  "seo": {
    "indexing": "navigable"
  },
  "redirects": [
    {
      "source": "/api-reference/fx/execute-fx-exchange",
      "destination": "/api-reference/fx/create-fx-exchange"
    },
    {
      "source": "/api-reference/instruments/create-instrument-for-beneficiary",
      "destination": "/api-reference/instruments/create-instrument"
    },
    {
      "source": "/api-reference/beneficiaries/rescore-beneficiary",
      "destination": "/api-reference/beneficiaries/rescreen-beneficiary"
